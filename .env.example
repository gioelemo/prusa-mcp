# Prusa Connect credentials
PRUSA_EMAIL=your-email@example.com
PRUSA_PASSWORD=your-password-here

# Prusa Connect URL (optional, defaults to https://connect.prusa3d.com)
PRUSA_CONNECT_URL=https://connect.prusa3d.com

# Session state file path (optional, defaults to connect_state.json)
PRUSA_CONNECT_STATE=connect_state.json

# Browser settings
# Set to 0 to watch the browser during login (useful for debugging)
HEADLESS=1

# Playwright tracing for debugging (set to 1 to enable, generates trace.zip)
PW_TRACING=0

# Timeouts in milliseconds
PW_NAV_TIMEOUT_MS=30000
PW_SEL_TIMEOUT_MS=15000
