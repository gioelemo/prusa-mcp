# Prusa Connect URL (optional, defaults to https://connect.prusa3d.com)
PRUSA_CONNECT_URL=https://connect.prusa3d.com

# Path to the OAuth token file.
# Authentication uses OAuth2 (Authorization Code + PKCE) against
# account.prusa3d.com — run `prusa-mcp login` once to create this file.
# Defaults to ~/.config/prusa-mcp/tokens.json when unset.
PRUSA_TOKEN_FILE=./data/prusa_tokens.json

# Override the public OAuth client id (optional; defaults to the PrusaSlicer client).
# PRUSA_OAUTH_CLIENT_ID=

# Override the Prusa Account base URL (optional).
# PRUSA_ACCOUNT_URL=https://account.prusa3d.com
